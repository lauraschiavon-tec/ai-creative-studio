MUAPI_API_KEY=
MUAPI_API_KEY_SANDBOX=
MUAPI_ENV=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Login pela Dashboard (mesmos usuários, senhas e permissões)
# Mesmo valor de AISTUDIO_SSO_SECRET no backend da Dashboard (Railway). Gere com: openssl rand -hex 32
AISTUDIO_SSO_SECRET=
# Assina a sessão do AI Studio. Opcional (sem ela deriva da SUPABASE_SECRET_KEY).
AISTUDIO_SESSION_SECRET=
# Login antigo por e-mail (Supabase Auth). Fallback temporário; "off" desliga.
LEGACY_LOGIN=on
