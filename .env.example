MUAPI_API_KEY=
MUAPI_API_KEY_SANDBOX=
MUAPI_ENV=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Login pela Dashboard (mesmos usuários, senhas e permissões)
# Mesmo valor de AISTUDIO_SSO_SECRET no backend da Dashboard (Railway). Gere com: openssl rand -hex 32
AISTUDIO_SSO_SECRET=
# Assina a sessão do AI Studio. Opcional (sem ela deriva da SUPABASE_SECRET_KEY).
AISTUDIO_SESSION_SECRET=
# Login antigo por e-mail (Supabase Auth). Fallback temporário; "off" desliga.
LEGACY_LOGIN=on

# Webhook da MuAPI (a geração termina mesmo com a página fechada). Tudo opcional:
# URL pública https do AI Studio. Sem ela usa o host da requisição (x-forwarded-host). Ex.: https://studio.suaempresa.com
AISTUDIO_PUBLIC_URL=
# Assina a URL do webhook de cada geração. Sem ela deriva da AISTUDIO_SESSION_SECRET / SUPABASE_SECRET_KEY.
MUAPI_WEBHOOK_SECRET=
# "off" desliga o webhook (o polling continua funcionando sozinho).
MUAPI_WEBHOOK=

# APIs diretas dos provedores (seletor "MuAPI / API direta" nos modelos que têm API direta). Tudo opcional:
# sem a chave, o seletor daquele provedor nem aparece. Exige a migration 005. Sem Sandbox: cobra na conta do provedor.
# BytePlus ModelArk (Seedream 5.0 e Seedance 2.5). Ative os modelos no Ark Console. Base opcional: BYTEPLUS_BASE_URL
BYTEPLUS_API_KEY=
# OpenAI (GPT Image 2.5). Precisa de créditos na conta (e, às vezes, Organization Verification).
OPENAI_API_KEY=
# Google Gemini API (Nano Banana Pro e Gemini Omni Flash). Precisa de billing ativo no projeto.
GEMINI_API_KEY=
# Kling Open Platform (Kling 3.0). Base opcional: KLING_BASE_URL (padrão https://api-singapore.klingai.com)
KLING_API_KEY=
